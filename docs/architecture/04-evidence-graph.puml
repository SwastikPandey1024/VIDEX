@startuml VIDEX-Evidence-Graph

title VIDEX — Evidence Graph & Spatiotemporal Memory Model

skinparam backgroundColor #0D1117
skinparam shadowing false
skinparam defaultFontColor white
skinparam ArrowColor #9CA3AF

skinparam class {
    BackgroundColor #162033
    BorderColor #4B6B9A
}

class Video {
    +video_id: UUID
    +filename: str
    +duration_sec: float
    +fps: float
    +width: int
    +height: int
    +has_audio: bool
}

class Scene {
    +scene_id: UUID
    +start_time: float
    +end_time: float
    +scene_index: int
}

class Frame {
    +frame_id: UUID
    +frame_index: int
    +timestamp_sec: float
    +uri: str
}

class Detection {
    +detection_id: UUID
    +class_name: str
    +confidence: float
    +bbox: BBox
}

class Track {
    +track_id: UUID
    +class_name: str
    +first_seen: float
    +last_seen: float
    +confidence: float
}

class TrajectoryPoint {
    +timestamp_sec: float
    +x: float
    +y: float
    +pixel_velocity: float
    +direction: str
}

class SpatialZone {
    +zone_id: str
    +zone_name: str
    +polygon_points: list
}

class OCRObservation {
    +ocr_id: UUID
    +text: str
    +confidence: float
    +first_seen: float
    +last_seen: float
    +bbox: BBox
}

class AudioSegment {
    +audio_id: UUID
    +start_time: float
    +end_time: float
    +source: str
}

class TranscriptSegment {
    +text: str
    +language: str
    +confidence: float
}

class Event {
    +event_id: UUID
    +event_type: str
    +start_time: float
    +end_time: float
    +confidence: float
    +status: str
}

class SemanticEvent {
    +semantic_event_id: UUID
    +event_type: str
    +interpretation: str
    +confidence: float
    +start_time: float
    +end_time: float
    +routing_decision: str
}

class Evidence {
    +evidence_id: UUID
    +evidence_type: str
    +timestamp_sec: float
    +source: str
    +confidence: float
    +frame_id: UUID
    +track_id: UUID
}

class BBox {
    +x1: float
    +y1: float
    +x2: float
    +y2: float
}

' Containment and Structural Hierarchy
Video "1" --> "*" Scene : CONTAINS
Video "1" --> "*" Frame : CONTAINS
Video "1" --> "*" SpatialZone : CONTAINS
Scene "1" --> "*" Frame : CONTAINS

' Perception & Spatial Layout
Frame "1" --> "*" Detection : CONTAINS / PRODUCES
Detection "*" --> "0..1" Track : BELONGS_TO
Track "1" --> "*" TrajectoryPoint : FOLLOWS
Track "*" --> "*" SpatialZone : OCCURS_IN
Detection "*" --> "*" Detection : SPATIALLY_OVERLAPS

' Multimodal Perception
Frame "1" --> "*" OCRObservation : CONTAINS
OCRObservation "*" --> "*" Frame : SUPPORTED_BY
AudioSegment "1" --> "*" TranscriptSegment : CONTAINS
Frame "*" --> "*" AudioSegment : TEMPORALLY_ALIGNED

' Deterministic Events (Layer 2 & 3)
Track "*" --> "*" Event : PARTICIPATES_IN
OCRObservation "*" --> "*" Event : SUPPORTS
AudioSegment "*" --> "*" Event : SUPPORTS
SpatialZone "*" --> "*" Event : OCCURS_IN
Scene "*" --> "*" Event : CONTEXTUALIZES

' Spatiotemporal Event Topology
Event "*" --> "*" Event : PRECEDES / FOLLOWS
Event "*" --> "*" Event : TEMPORALLY_NEAR

' Layer 5 Semantic Reasoning & Provenance
Event "1..*" --> "0..1" SemanticEvent : SUPPORTS_SEMANTIC_EVENT
SemanticEvent "1" --> "1..*" Event : DERIVED_FROM

' Grounding to Evidence Store
Event "1" --> "*" Evidence : SUPPORTED_BY
SemanticEvent "1" --> "*" Evidence : SUPPORTED_BY
Evidence "*" --> "1" Frame : REFERENCES
Evidence "*" --> "0..1" Track : REFERENCES
Evidence "*" --> "0..1" OCRObservation : REFERENCES
Evidence "*" --> "0..1" AudioSegment : REFERENCES

@enduml