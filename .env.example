# ============================================================
# VIDEX — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=VIDEX
VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Storage paths ────────────────────────────────────────────
# Directories are relative to the repo root by default.
# Override with absolute paths in production.
DATA_DIR=data
FRAMES_DIR=data/frames
EVIDENCE_DIR=data/evidence

# ── Database (Phase 1+) ──────────────────────────────────────
# Required for persistence. Leave blank for in-memory/dev mode.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/videx

# ── Perception / Detection (Phase 1+) ────────────────────────
# Name of the active detector backend (matches provider registry key)
DETECTOR_PROVIDER=yolov8
DETECTOR_CONFIDENCE_THRESHOLD=0.3
DETECTOR_IOU_THRESHOLD=0.45
DETECTOR_DEVICE=cpu
# Path to detector model weights (relative or absolute)
DETECTOR_MODEL_PATH=models/weights/detector.pt

# ── Tracking (Phase 1+) ──────────────────────────────────────
TRACKER_PROVIDER=bytetrack
TRACKER_MAX_LOST_FRAMES=30

# ── OCR (Phase 1+) ───────────────────────────────────────────
OCR_PROVIDER=easyocr
OCR_LANGUAGES=hi,en

# ── ASR / Audio (Phase 1+) ───────────────────────────────────
ASR_PROVIDER=whisper
ASR_MODEL_SIZE=large-v3
ASR_LANGUAGE=hi

# ── VLM / Semantic Reasoning (Phase 2+) ─────────────────────
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
